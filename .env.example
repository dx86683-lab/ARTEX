# Docker 部署配置（复制为 .env）
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# 监听地址，默认只绑本机；远程访问时改为 0.0.0.0，并放在 TLS 反向代理后面
ARTEX_BIND=127.0.0.1
# 首次设置管理员密码用的令牌；留空则随机生成并打印到启动日志（docker compose logs artex）
ARTEX_INIT_TOKEN=
